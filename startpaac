  rm -f "${KUBECONFIG}"
}

install_pac() {
  tmppac=$(mktemp /tmp/.pac.config.XXXXXX)

  if [[ -n ${1:-""} ]]; then
    show_step "Deploying PAC $1"
  else
    show_step "Deploying PAC"
  fi
  local c=config
  case ${1:-""} in
  controller)
    c=${c}/400-controller.yaml
    ;;
  watcher)
    c=${c}/500-watcher.yaml
    ;;
  webhook)
    c=${c}/600-webhook.yaml
    ;;
  esac
  local -a extras=()
  if [[ -z ${1:-} && -e ${PAC_DIR}/pkg/test/nonoai/deployment.yaml ]]; then
    extras+=(-f "${PAC_DIR}/pkg/test/nonoai/deployment.yaml")
  fi

  require_tool ko

  # Verify registry is accessible before ko resolve
  echo "Verifying registry ${REGISTRY} is accessible..."
  local reg_ok=false
  for ((i = 1; i <= 5; i++)); do
    if curl --connect-timeout 5 --max-time 10 -o/dev/null --fail -k -s "https://${REGISTRY}/v2/"; then
      reg_ok=true
      break
    fi
    echo "Registry not ready, retrying in 5s ($i/5)..."
    sleep 5
  done
  if [[ ${reg_ok} != true ]]; then
    echo "Warning: Registry ${REGISTRY} not responding, proceeding anyway..."
  fi

  # ko resolve with retry logic for intermittent registry failures
  local ko_success=false
  local ko_max_retries=3
  for ((attempt = 1; attempt <= ko_max_retries; attempt++)); do
    if env KO_DOCKER_REPO="${REGISTRY}" ko resolve -f"${c}" "${extras[@]}" -B --sbom=none "${KO_EXTRA_FLAGS[@]}" >"${tmppac}"; then
      ko_success=true
      break
    fi
    if [[ ${attempt} -lt ${ko_max_retries} ]]; then
      echo "ko resolve failed (attempt ${attempt}/${ko_max_retries}), retrying in 15s..."
      sleep 15
    fi
  done
  if [[ ${ko_success} != true ]]; then
    echo "ko resolve failed after ${ko_max_retries} attempts"
    return 1
  fi
  if [[ -n ${PAC_IMAGE_NONROOT} && "${PAC_IMAGE_NONROOT}" == false ]]; then
    sed -i 's/^\(\s*runAsNonRoot:\) true/\1 false/' "${tmppac}"
  fi
  kubectl apply -f "${tmppac}"
  echo "Using config from: ${c}"

  for controller in ${scale_down_controller}; do
    kubectl scale deployment -n pipelines-as-code -l "app.kubernetes.io/name=${controller}" --replicas=0
  done
}

create_pac_secret() (
  local folder=$1 secret_name=$2 target_ns=$3 secret_tmp passk value
  shift 3
  local -a read_method=("$@")
  umask 077
  secret_tmp=$(mktemp -d /tmp/.startpaac-secret.XXXXXX)
  trap 'rm -rf "${secret_tmp}"' EXIT
  for passk in github-application-id github-private-key webhook.secret; do
    if ! "${read_method[@]}" "${folder}/${passk}" >"${secret_tmp}/${passk}" 2>/dev/null || [[ ! -s ${secret_tmp}/${passk} ]]; then
      echo 'Cannot read PAC credentials; existing cluster secrets were left unchanged.' >&2
      return 1
    fi
    if [[ ${passk} != github-private-key ]]; then
      value=$(<"${secret_tmp}/${passk}")
      printf '%s' "${value}" >"${secret_tmp}/${passk}"
    fi
  done
  if ! kubectl create secret generic "${secret_name}" -n "${target_ns}" \
    --from-file="github-application-id=${secret_tmp}/github-application-id" \
    --from-file="github-private-key=${secret_tmp}/github-private-key" \
    --from-file="webhook.secret=${secret_tmp}/webhook.secret" \
    --dry-run=client -o yaml 2>/dev/null | kubectl apply -f - 2>/dev/null; then
    echo 'Cannot apply PAC credentials.' >&2
    return 1
  fi
)

patch_configmap() {
  local target_ns=${1:-pipelines-as-code}
  local configmap=${2:-pipelines-as-code}
  local kind_url="http://${DASHBOARD}"
  kubectl patch configmap -n "${target_ns}" -p \
    "{\"data\":{\"bitbucket-cloud-check-source-ip\": \"false\"}}" \
    --type merge "${configmap}"

  kubectl patch configmap -n "${target_ns}" -p \
    "{\"data\":{\"tekton-dashboard-url\": \"${kind_url}\"}}" \
    --type merge "${configmap}"

  kubectl patch configmap pac-config-logging -n "${target_ns}" \
    --type merge \
    -p '{"data":{
      "loglevel.pac-watcher":"debug",
      "loglevel.pipelines-as-code-webhook":"debug",
      "loglevel.pipelinesascode":"debug"
    }}'
}

# Persist (add or update) a variable assignment in the startpaac config file
persist_config_var() {
  local var=$1 value=$2
  [[ -e ${CONFIG_FILE} ]] || return 0
  if grep -q "^${var}=" "${CONFIG_FILE}"; then
    sed -i.startpaac.bak "s|^${var}=.*|${var}=${value}|" "${CONFIG_FILE}" &&
      rm -f "${CONFIG_FILE}.startpaac.bak"
  else
    printf '%s=%s\n' "${var}" "${value}" >>"${CONFIG_FILE}"
  fi
}

# Guided GitHub App creation via the GitHub App Manifest flow.
# Generates a hook.pipelinesascode.com relay URL, runs a small local python
# server to receive the GitHub redirect, then stores the credentials in pass
# or in a plain text folder.
setup_github_app() {
  local storage location smee_url app_name org="" outdir summary app_url install_url persist_secret_folder=""
  show_step "GitHub App setup"

  require_tool python3
  require_tool curl
  require_tool jq

  # Storage: when both pass and a plain folder are configured, let the user pick
  local have_pass=""
  [[ -n ${PAC_PASS_SECRET_FOLDER:-} ]] && command -v pass &>/dev/null && have_pass=1
  if [[ -n ${have_pass} && -n ${PAC_SECRET_FOLDER:-} ]]; then
    if _confirm "Store credentials with pass under ${PAC_PASS_SECRET_FOLDER}? (No = plain files in ${PAC_SECRET_FOLDER})"; then
      storage=pass
    else
      storage=folder
    fi
  elif [[ -n ${have_pass} ]]; then
    storage=pass
  else
    storage=folder
  fi
  if [[ ${storage} == pass ]]; then
    location="pass folder ${PAC_PASS_SECRET_FOLDER}"
  else
    if [[ -z ${PAC_SECRET_FOLDER:-} ]]; then
      PAC_SECRET_FOLDER="${HOME}/.local/share/startpaac/secrets"
      persist_secret_folder=1
    fi
    (umask 077 && mkdir -p "${PAC_SECRET_FOLDER}")
    location="folder ${PAC_SECRET_FOLDER}"
  fi
  echo "Credentials will be stored in ${location}"

  if pac_secrets_complete "${storage}"; then
    _confirm "GitHub App credentials already exist in ${location}. Create a new app and replace them?" || return 0
  fi

  if ! _confirm "Create the GitHub App under your personal account? (No = organization)"; then
    org=$(_input "GitHub organization name" "")
    [[ -z ${org} ]] && {
      echo "No organization given, aborting GitHub App setup"
      return 1
    }
  fi

  app_name=$(_input "GitHub App name (must be globally unique)" "pac-${USER}-$((RANDOM % 9000 + 1000))")
  [[ -z ${app_name} ]] && {
    echo "No app name given, aborting GitHub App setup"
    return 1
  }

  echo "Generating a webhook relay URL from https://hook.pipelinesascode.com"
  echo_color yellow "Note: this public relay is for development only, with no support or security guarantees."
  smee_url=$(curl -fsSL https://hook.pipelinesascode.com/new | tr -d '[:space:]')
  [[ ${smee_url} == https://* ]] || {
    echo "Failed to generate a relay URL from hook.pipelinesascode.com"
    return 1
  }
  echo "Relay URL: ${smee_url}"

  outdir=$(mktemp -d /tmp/.startpaac-ghapp.XXXXXX)
  # shellcheck disable=SC2317
  __clean_ghapp() { rm -rf "${outdir}"; }
  trap __clean_ghapp RETURN

  local -a helper_args=(--app-name "${app_name}" --webhook-url "${smee_url}" --output-dir "${outdir}")
  [[ -n ${org} ]] && helper_args+=(--org "${org}")

  echo "Opening your browser to create the GitHub App (waiting up to 5 minutes)..."
  if ! summary=$(python3 "${SP}/lib/github_app_create.py" "${helper_args[@]}"); then
    echo "GitHub App creation failed"
    return 1
  fi

  printf '%s' "${smee_url}" >"${outdir}/smee"

  local key
  if [[ ${storage} == pass ]]; then
    for key in github-application-id github-private-key webhook.secret smee; do
      pass insert -m -f "${PAC_PASS_SECRET_FOLDER}/${key}" <"${outdir}/${key}" >/dev/null
    done
  else
    for key in github-application-id github-private-key webhook.secret smee; do
      install -m 600 "${outdir}/${key}" "${PAC_SECRET_FOLDER}/${key}"
    done
  fi

  # Persist the storage preference only now that credentials were stored, so
  # an aborted or failed setup never pins an empty backend in the config.
  PAC_SECRET_STORAGE=${storage}
  persist_config_var PAC_SECRET_STORAGE "${PAC_SECRET_STORAGE}"
  if [[ -n ${persist_secret_folder} ]]; then
    persist_config_var PAC_SECRET_FOLDER "${PAC_SECRET_FOLDER}"
  fi

  app_url=$(jq -r '.html_url' <<<"${summary}")
  install_url=$(jq -r '.install_url' <<<"${summary}")
  echo_color brightgreen "GitHub App created: ${app_url}"
  echo "Now install the app on the repositories you want to use with PAC:"
  echo_color brightwhite "  ${install_url}"
  if _confirm "Open the app installation page in your browser?"; then
    python3 -c 'import sys, webbrowser; webbrowser.open(sys.argv[1])' "${install_url}"
  fi

  # Offer a persistent webhook forwarder now that we have a relay URL
  start_user_gosmee gosmee
  return 0
}

# Offer the guided GitHub App setup when credentials are missing, but only
# in interactive (non-CI, tty) runs.
maybe_setup_github_app() {
  [[ ${NON_INTERACTIVE:-false} != true ]] || return 0
  [[ ${CI_MODE} == "true" ]] && return 0
  [[ -t 0 && -t 1 ]] || return 0
  pac_secrets_complete && return 0
  [[ ${PAC_SKIP_GITHUB_APP_PROMPT:-false} == "true" ]] && return 0
  echo_color yellow "No usable GitHub App credentials found (missing or empty secrets)."
  if _confirm "Create a GitHub App now? (opens your browser)"; then
    setup_github_app || echo_color brightred "GitHub App setup failed, continuing without secrets"
  else
    PAC_SKIP_GITHUB_APP_PROMPT=true
    persist_config_var PAC_SKIP_GITHUB_APP_PROMPT true
    echo "Not asking again on future runs; use 'startpaac --setup-github-app' when ready."
  fi
  return 0
}

configure_pac() {
  local pac_controller_secret=pipelines-as-code-secret no_ingress="" credential_storage=""
  if [[ ${NON_INTERACTIVE:-false} == true ]] && ! pac_secrets_complete; then
    cli_error credentials_unavailable 'GitHub App credentials are unavailable; existing cluster secrets were left unchanged.' 'Restore credential access before retrying.'
    return 1
  fi
  show_step "Configuring PAC"
  [[ -n ${1:-} && ${1} == "--no-ingress" ]] && no_ingress=yes
  maybe_setup_github_app
  if [[ -z ${no_ingress} ]]; then
    create_httproute pipelines-as-code pipelines-as-code-controller "${PAC}" 8080
  fi
  patch_configmap "${PAC_CONTROLLER_TARGET_NS}"

  credential_storage=$(pac_secret_storage)
  if [[ ${credential_storage} == pass ]] && pac_secrets_complete pass; then
    echo "Installing PAC secrets from pass folder: ${PAC_PASS_SECRET_FOLDER}"
    create_pac_secret "${PAC_PASS_SECRET_FOLDER}" "${pac_controller_secret}" "${PAC_CONTROLLER_TARGET_NS}" pass show
  elif [[ ${credential_storage} == folder ]] && pac_secrets_complete folder; then
    echo "Installing PAC secrets from plain text folder: ${PAC_SECRET_FOLDER}"
    create_pac_secret "${PAC_SECRET_FOLDER}" "${pac_controller_secret}" "${PAC_CONTROLLER_TARGET_NS}" cat
  else
    if [[ ${NON_INTERACTIVE:-false} == true ]]; then
      cli_error credentials_unavailable 'GitHub App credentials became unavailable; existing cluster secrets were left unchanged.' 'Restore credential access before retrying.'
      return 1
    fi
    cat <<EOF
  **No secret has been installed**

  No usable GitHub App credentials were found (files may be missing or empty).

  You need to either create a pass https://www.passwordstore.org/ folder with
  github-application-id github-private-key webhook.secret information in there
  and export the PAC_PASS_SECRET_FOLDER variable to that folder

  Or have a plain text folder with the same structure and export the
  PAC_SECRET_FOLDER variable

  Or run "startpaac --setup-github-app" to create a GitHub App automatically.
EOF
    kubectl delete secret -n pipelines-as-code pipelines-as-code-secret >/dev/null 2>/dev/null || true
  fi
}

configure_pac_custom_certs() {
  local ns=${PAC_CONTROLLER_TARGET_NS:-pipelines-as-code}
  local ca_file="${CERT_DIR}/minica.pem"
  local cm_name="pac-custom-certs"

  # Check if minica CA exists
  if [[ ! -f "${ca_file}" ]]; then
    echo "No minica CA found at ${ca_file}, skipping custom cert configuration"
    return 0
  fi

  show_step "Configuring PAC with minica CA"

  # Create/update ConfigMap with minica CA
  kubectl delete configmap ${cm_name} -n ${ns} 2>/dev/null || true
  kubectl create configmap ${cm_name} -n ${ns} --from-file=ca.crt="${ca_file}"

  # Patch all PAC deployments to mount the CA and set SSL_CERT_DIR
  for deployment in pipelines-as-code-controller pipelines-as-code-watcher pipelines-as-code-webhook; do
    kubectl patch deployment ${deployment} -n ${ns} --type=json -p='[
      {
        "op": "add",
        "path": "/spec/template/spec/volumes/-",
        "value": {
          "name": "pac-custom-certs",
          "configMap": {
            "name": "pac-custom-certs"
          }
        }
      },
      {
        "op": "add",
        "path": "/spec/template/spec/containers/0/volumeMounts/-",
        "value": {
          "name": "pac-custom-certs",
          "mountPath": "/pac-custom-certs",
          "readOnly": true
        }
      }
    ]' 2>/dev/null || true

    kubectl set env deployment ${deployment} -n ${ns} \
      SSL_CERT_DIR=/pac-custom-certs:/etc/ssl/certs:/etc/pki/tls/certs:/system/etc/security/cacerts
  done

  echo "Waiting for PAC controller to restart..."
  kubectl rollout status deployment/pipelines-as-code-controller -n ${ns} --timeout=60s
}

function patch_pac_service_nodeport() {
  if [[ "${USE_NODEPORT_WEBHOOK}" != "true" ]]; then
    return
  fi
  show_step "Patching PAC controller service to NodePort ${PAC_WEBHOOK_NODEPORT}"
  kubectl patch svc pipelines-as-code-controller -n pipelines-as-code \
    --type='json' -p='[
      {"op": "replace", "path": "/spec/type", "value": "NodePort"},
      {"op": "add", "path": "/spec/ports/0/nodePort", "value": '${PAC_WEBHOOK_NODEPORT}'}
    ]'
}

