execute_action() {
  case ${CLI_ACTION} in
  --install-forgejo)
    run_with_hooks install-forgejo install_forgejo ${FORGE_HOST}
    run_with_hooks setup-forgejo-sample setup_forgejo_sample
    exit
    ;;
  --sync-kubeconfig)
    run_with_hooks sync-kubeconfig sync_kubeconfig
    exit
    ;;
  --github-second-ctrl)
    run_with_hooks install-github-second-ctrl install_github_second_ctrl
    exit
    ;;
  --all-github-second-no-forgejo)
    INSTALL_FORGE=false
    install_kind
    all
    run_with_hooks install-github-second-ctrl install_github_second_ctrl
    show_config
    exit
    ;;
  --start-user-gosmee)
    start_user_gosmee gosmee
    exit
    ;;
  --all-but-forge)
    INSTALL_FORGE=false
    all
    exit
    ;;
  --install-tekton)
    run_with_hooks install-tekton install_tekton
    exit
    ;;
  --all)
    install_kind
    all
    show_config
    exit
    ;;
  --all-but-kind)
    all
    exit
    ;;
  --deploy-component)
    run_with_hooks install-pac install_pac "${CLI_VALUE}"
    exit
    ;;
  --install-paac)
    run_with_hooks install-pac install_pac
    run_with_hooks configure-pac configure_pac
    run_with_hooks configure-pac-custom-certs configure_pac_custom_certs
    run_with_hooks patch-pac-service-nodeport patch_pac_service_nodeport
    exit
    ;;
  --kind)
    install_kind
    run_with_hooks sync-kubeconfig sync_kubeconfig
    exit
    ;;
  --reset-preferences)
    reset_preferences
    exit 0
    ;;
  --setup-forgejo-sample)
    run_with_hooks setup-forgejo-sample setup_forgejo_sample
    exit
    ;;
  --debug-image)
    show_step "Using debug image:  ${PAC_DEBUG_IMAGE}"
    export KO_DEFAULTBASEIMAGE=${PAC_DEBUG_IMAGE}
    PAC_IMAGE_NONROOT=false
    run_with_hooks install-pac install_pac
    echo
    echo "You can oc rsh to controller (or watcher, webhook) with:"
    echo "kubectl exec -it deployment/pipelines-as-code-controller -- bash"
    exit
    ;;
  --second-secret)
    PAC_PASS_SECOND_FOLDER=${CLI_VALUE}
    run_with_hooks install-github-second-ctrl install_github_second_ctrl
    exit
    ;;
  --show-config)
    show_config
    exit
    ;;
  --setup-github-app)
    setup_github_app
    exit
    ;;
  --install-registry)
    run_with_hooks install-registry install_registry
    exit
    ;;
  --install-postgresql)
    run_with_hooks install-postgresql install_postgresql
    exit
    ;;
  --install-dashboard)
    run_with_hooks install-dashboard install_dashboard
    exit
    ;;
  --install-triggers)
    run_with_hooks install-triggers install_triggers
    exit
    ;;
  --install-chains)
    run_with_hooks install-chains install_chains
    exit
    ;;
  --install-gateway)
    run_with_hooks install-gateway install_gateway
    exit
    ;;
  --all-to-tekton)
    install_kind
    run_with_hooks sync-kubeconfig sync_kubeconfig
    run_with_hooks install-gateway install_gateway
    run_with_hooks install-registry install_registry
    run_with_hooks install-tekton install_tekton
    show_config
    exit
    ;;
  --configure-pac)
    run_with_hooks configure-pac configure_pac
    exit
    ;;
  --configure-pac-target)
    export KUBECONFIG=$1
    export PAC_CONTROLLER_TARGET_NS=$2
    if [[ -d ~/.password-store/$3 ]]; then
      export PAC_PASS_SECRET_FOLDER=$3
      smee_url=$(pass show ${PAC_PASS_SECRET_FOLDER}/smee)
    elif [[ -d $3 ]]; then
      export PAC_SECRET_FOLDER=$3
      smee_url=$(cat ${PAC_SECRET_FOLDER}/smee)
    else
      echo "Cannot find $3 folder or ~/.password-store/$3 folder"
      exit 1
    fi
    run_with_hooks configure-pac configure_pac --no-ingress
    if [[ "${USE_NODEPORT_WEBHOOK}" != "true" ]]; then
      show_step "Creating gosmee service in namespace gosmee"
      makeGosmee gosmee ${smee_url} http://pipelines-as-code-controller.$PAC_CONTROLLER_TARGET_NS.svc.cluster.local:8080 gosmee
    else
      run_with_hooks patch-pac-service-nodeport patch_pac_service_nodeport
      echo "NodePort webhook enabled, skipping gosmee deployment"
    fi
    exit
    ;;
  --stop-kind)
    run_with_hooks stop-kind stop_kind
    exit
    ;;
  --redeploy-kind)
    install_kind
    run_with_hooks sync-kubeconfig sync_kubeconfig
    exit
    ;;
  "") ;;
  *)
    echo "Not implemented"
    help
    exit 1
    ;;
  esac

  # No arguments given - interactive mode (or CI mode)
  show_config
  echo

  # In CI mode, skip all interactive prompts
  if [[ ${CI_MODE} == "true" ]]; then
    echo_color yellow "CI mode enabled - using defaults, skipping interactive prompts"
    # Use preferences if available, otherwise use defaults
    [[ -f ${PREFERENCES_FILE} ]] && load_preferences
    show_selected_components
    install_kind
    all
    show_config
    exit
  fi

  # Determine whether to show menu
  local show_menu=true

  if [[ -f ${PREFERENCES_FILE} && ${FORCE_INTERACTIVE} != "true" ]]; then
    show_menu=false
    load_preferences
    echo_color yellow "Using saved preferences from ${PREFERENCES_FILE}"
    echo_color yellow "Run with --menu to change, or --reset-preferences to clear."
  fi

  if [[ ${show_menu} == "true" ]]; then
    show_component_menu
    prompt_save_preferences
  fi

  show_selected_components

  # Final confirmation
  if ! _confirm "Proceed with installation?"; then
    echo "Installation cancelled."
    exit 1
  fi

  # Run the interactive GitHub App setup up front, while the user is still at
  # the keyboard, instead of minutes into the deployment.
  [[ ${INSTALL_PAC} == "true" ]] && maybe_setup_github_app

  install_kind
  all
  show_config
  exit
}

cli_main "$@"
