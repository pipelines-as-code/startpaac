set -Eeufo pipefail

Miself=${BASH_SOURCE[0]}
[[ ${Miself} == */* ]] || Miself=./${Miself}
while [[ -L ${Miself} ]]; do
  _dir=$(cd -P -- "${Miself%/*}" && pwd)
  Miself=$(readlink "${Miself}")
  [[ ${Miself} == /* ]] || Miself=${_dir}/${Miself}
done
SP=$(cd -P -- "${Miself%/*}" && pwd)
Miself=${SP}/${Miself##*/}
source "${SP}/lib/common.sh"
source "${SP}/lib/cli.sh"

initialize_runtime() {
  source "${SP}/lib/config.sh"
  [[ ${CLI_LOCAL_TARGET} != true ]] || TARGET_HOST=local
  PAC_CONTROLLER_TARGET_NS=pipelines-as-code
  _git_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
  if [[ ${SETUP_GITHUB_APP_ONLY} != true ]]; then
    if [[ -z ${PAC_DIR:-} && -f ${_git_root}/config/400-controller.yaml ]]; then
      PAC_DIR=${_git_root}
    fi
    if [[ ${CLI_MANAGED} != true ]]; then
      [[ -n ${PAC_DIR:-} ]] || {
        echo "You really need to set the PAC_DIR variable in your ${CONFIG_FILE}"
        exit 1
      }
      cd "${PAC_DIR}" || {
        echo "cannot find the pipelines-as-code directory, set PAC_DIR in ${CONFIG_FILE}"
        exit 1
      }
    fi
  fi

  TARGET_HOST=${TARGET_HOST:-local}
  DOMAIN_NAME=${DOMAIN_NAME:-""}
  PAC_DOMAIN=${PAC_DOMAIN:-""}
  PAC=${PAC:-""}
  REGISTRY=${REGISTRY:-""}
  KO_EXTRA_FLAGS=${KO_EXTRA_FLAGS:-""}
  FORGE_HOST=${FORGE_HOST:-""}
  INSTALL_GITHUB_SECOND_CTRL=${INSTALL_GITHUB_SECOND_CTRL:-""}
  INSTALL_FORGE=${INSTALL_FORGE:-"true"}
  PAC_PASS_SECOND_FOLDER=${PAC_PASS_SECOND_FOLDER:-}
  PAC_GITHUB_SECOND_HOSTNAME=${PAC_GITHUB_SECOND_HOSTNAME:-${TEST_GITHUB_SECOND_API_URL:-}}
  PAC_DEBUG_IMAGE=${PAC_DEBUG_IMAGE:-registry.access.redhat.com/ubi9/ubi-minimal}
  PAC_IMAGE_NONROOT=${PAC_IMAGE_NONROOT:-"true"}
  GOSMEE_LOG_LEVEL=${GOSMEE_LOG_LEVEL:-debug}
  GOSMEE_TARGET_TIMEOUT=${GOSMEE_TARGET_TIMEOUT:-5}
  GOSMEE_TARGET_RETRIES=${GOSMEE_TARGET_RETRIES:-5}

  # Component installation preferences
  PREFERENCES_FILE="${HOME}/.config/startpaac/preferences.json"
  INSTALL_PAC=${INSTALL_PAC:-"true"}
  INSTALL_TEKTON_TRIGGERS=${INSTALL_TEKTON_TRIGGERS:-"false"}
  INSTALL_TEKTON_CHAINS=${INSTALL_TEKTON_CHAINS:-"false"}
  INSTALL_TEKTON_DASHBOARD=${INSTALL_TEKTON_DASHBOARD:-"true"}
  INSTALL_POSTGRESQL=${INSTALL_POSTGRESQL:-"false"}
  INSTALL_CUSTOM_OBJECT_ENABLED=${INSTALL_CUSTOM_OBJECT_ENABLED:-"false"}
  FORCE_INTERACTIVE=${FORCE_INTERACTIVE:-"false"}
  NON_INTERACTIVE=${NON_INTERACTIVE:-"false"}

  # CI mode settings
  CI_MODE=${CI_MODE:-"false"}
  export CI_MODE

  if [[ ${TARGET_HOST} == local ]]; then
    KO_EXTRA_FLAGS=(--insecure-registry)
    DOMAIN_NAME=${TARGET_HOST}
    # Allow domain override via PAC_DOMAIN for CI compatibility
    PAC_DOMAIN=${PAC_DOMAIN:-"127.0.0.1.nip.io"}
    REGISTRY=registry.${PAC_DOMAIN}
    FORGE_HOST=gitea.${PAC_DOMAIN}
    TARGET_BIND_IP=127.0.0.1
    DASHBOARD=dashboard.${PAC_DOMAIN}
    PAC=paac.${PAC_DOMAIN}
    # Default to NodePort webhook for local mode
    USE_NODEPORT_WEBHOOK=${USE_NODEPORT_WEBHOOK:-true}
  else
    USE_NODEPORT_WEBHOOK=${USE_NODEPORT_WEBHOOK:-false}
  fi

  # NodePort configuration for direct webhook delivery
  PAC_WEBHOOK_NODEPORT=${PAC_WEBHOOK_NODEPORT:-30080}
  if [[ "${USE_NODEPORT_WEBHOOK}" == "true" ]]; then
    PAC_WEB_URL=${PAC_WEB_URL:-"http://${TARGET_BIND_IP:-127.0.0.1}:${PAC_WEBHOOK_NODEPORT}"}
  else
    PAC_WEB_URL=${PAC_WEB_URL:-"https://${PAC}"}
  fi
  PAC_WEBHOOK_SECRET=${PAC_WEBHOOK_SECRET:-""}

  [[ ${CLI_MANAGED} != true && ${SETUP_GITHUB_APP_ONLY} != true && (-z ${DOMAIN_NAME} || -z ${TARGET_HOST} || -z ${TARGET_BIND_IP:-} || -z ${REGISTRY} || -z ${DASHBOARD:-} || -z ${PAC}) ]] && {
    echo "Need to set DOMAIN_NAME, TARGET_HOST, TARGET_BIND_IP, REGISTRY, DASHBOARD and PAC in your $HOME/.config/startpaac/config"
    exit 1
  }
  [[ -n ${DOMAIN_NAME} && -z ${PAC_DOMAIN} ]] && PAC_DOMAIN=${DOMAIN_NAME}

  export KUBECONFIG=${KUBECONFIG:-$HOME/.kube/config.${DOMAIN_NAME%%.*}}

  if [[ ${CLI_MANAGED} != true && ${SETUP_GITHUB_APP_ONLY} != true ]] && { [[ -z ${TARGET_HOST} ]] || [[ -z ${DOMAIN_NAME} ]] || [[ -z ${REGISTRY} ]] || [[ -z ${KUBECONFIG} ]]; }; then
    echo "Need env variable TARGET_HOST, DOMAIN_NAME and REGISTRY"
    exit 1
  fi

}

show_config() {
  local smee_url protocol
  smee_url=$(get_smee_url)
  protocol="https"
  cat <<EOF
Using configuration on ${TARGET_HOST}:

DOMAIN_NAME: ${DOMAIN_NAME},
TARGET_BIND_IP: ${TARGET_BIND_IP}
PAC: ${protocol}://${PAC}
REGISTRY: ${protocol}://${REGISTRY}
FORGE_HOST: ${protocol}://${FORGE_HOST}
DASHBOARD: ${protocol}://${DASHBOARD}
EOF
  if [[ "${USE_NODEPORT_WEBHOOK}" == "true" ]]; then
    echo "PAC WEBHOOK: ${PAC_WEB_URL} (NodePort - no gosmee needed)"
  else
    cat <<EOF
  GOSMEE:
  gosmee client --output json --log-level ${GOSMEE_LOG_LEVEL} --target-connection-timeout ${GOSMEE_TARGET_TIMEOUT} --target-retries ${GOSMEE_TARGET_RETRIES} --saveDir /tmp/replay ${smee_url} ${protocol}://${PAC}
EOF
  fi
}

# Downloaded manifests are cached and downloaded again once they are older than
# CACHE_MAX_AGE_DAYS, so the "latest" releases do not stay stuck on an old version.
CACHE_MAX_AGE_DAYS=${CACHE_MAX_AGE_DAYS:-21}

cache_yaml_file() {
  local type="$1"
  local url="$2"
  local cache_dir="${HOME}/.cache/startpaac"
  local filename="${cache_dir}/${type}.yaml"
  mkdir -p "${cache_dir}"

  if [[ -e "${filename}" ]] && [[ -n $(find "${filename}" -mtime +$((CACHE_MAX_AGE_DAYS - 1))) ]]; then
    echo "Cached ${type} manifest is older than ${CACHE_MAX_AGE_DAYS} days, downloading it again" >&2
    rm -f "${filename}"
  fi

  if [[ ! -e "${filename}" ]]; then
    curl --fail --connect-timeout 10 --max-time 120 --progress-bar -L --location --retry 10 --retry-max-time 10 -o "${filename}.tmp" "${url}" &&
      mv "${filename}.tmp" "${filename}"
  fi
  echo "${filename}"
}

check_kind() {
  output=$(ssh -q "${TARGET_HOST}" which kind || true)
  if [[ "${output}" == *"not found" ]]; then
    echo "Kind is not installed on ${TARGET_HOST}"
    exit 1
  fi
}

install_kind() {
  [[ "${TARGET_HOST}" != local ]] && check_kind
  if [[ ${CLI_ACTION:-} != --up ]]; then
    run_with_hooks stop-kind stop_kind
  fi
  show_step "Creating kind cluster"
  local kfilename="${SP}/lib/kind/kind.yaml"

  # Split TARGET_BIND_IP by comma to support multiple IPs
  IFS=',' read -ra BIND_IPS <<<"${TARGET_BIND_IP}"

  # Trim whitespace from each IP
  for i in "${!BIND_IPS[@]}"; do
    BIND_IPS[$i]=$(echo "${BIND_IPS[$i]}" | xargs)
  done

  local primary_ip="${BIND_IPS[0]}"

  # Start with the base template, replacing registry and primary IP
  sed -e "s/%REGISTRY%/${REGISTRY}/" -e "s/%TARGET_BIND_IP%/${primary_ip}/" "${kfilename}" >"${TMPFILE}"

  # If there are multiple IPs, add additional port mappings
  if [[ ${#BIND_IPS[@]} -gt 1 ]]; then
    # Create a temporary file for the extra port mappings
    local extra_mappings
    extra_mappings=$(mktemp)
    for ip in "${BIND_IPS[@]:1}"; do
      cat >>"${extra_mappings}" <<EOF
      - containerPort: 31080
        hostPort: 80
        listenAddress: "${ip}"
        protocol: TCP
      - containerPort: 31443
        hostPort: 443
        listenAddress: "${ip}"
        protocol: TCP
      - containerPort: 32567
        hostPort: 3000
        listenAddress: "${ip}"
        protocol: TCP
      - containerPort: 30080
        hostPort: 30080
        listenAddress: "${ip}"
        protocol: TCP
EOF
    done

    # Insert the extra mappings before the containerdConfigPatches section
    # Use gawk if available (macOS ships with BSD awk which is limited)
    local awk_cmd="awk"
    if command -v gawk >/dev/null 2>&1; then
      awk_cmd="gawk"
    fi

    "${awk_cmd}" -v extra="$(cat "${extra_mappings}")" '
      /^containerdConfigPatches:/ {
        if (!inserted) {
          print extra;
          inserted=1
        }
        print;
        next
      }
      {print}
    ' "${TMPFILE}" >"${TMPFILE}.new"
    mv "${TMPFILE}.new" "${TMPFILE}"
    rm -f "${extra_mappings}"
  fi
  case ${TARGET_HOST} in
  local)
    kind create cluster --kubeconfig "${KUBECONFIG}" --config "${TMPFILE}"
    ;;
  *)
    scp -q "${TMPFILE}" "${TARGET_HOST}":/tmp/.kind.yaml
    ssh -q "${TARGET_HOST}" kind create cluster --kubeconfig ".kube/$(basename "${KUBECONFIG}")" --config /tmp/.kind.yaml
    ;;
  esac
}

install_gateway() {
  local envoy_gateway_version="v1.8.2"
  show_step "Installing Envoy Gateway"
  helm upgrade --install --wait \
    --version "${envoy_gateway_version}" \
    --namespace envoy-gateway-system --create-namespace \
    envoy-gateway oci://docker.io/envoyproxy/gateway-helm >/dev/null
  wait_for_resource deployment envoy-gateway-system envoy-gateway

  show_step "Creating wildcard TLS cert for *.${PAC_DOMAIN}"
  local wildcard_cert_dir="_.${PAC_DOMAIN}" # minica turns "*" into "_" for the output dir
  generate_certs_minica "*.${PAC_DOMAIN}"
  kubectl create namespace envoy-gateway-system 2>/dev/null || true
  kubectl create secret tls startpaac-wildcard-tls \
    --key "${CERT_DIR}/${wildcard_cert_dir}/key.pem" \
    --cert "${CERT_DIR}/${wildcard_cert_dir}/cert.pem" \
    -n envoy-gateway-system \
    --dry-run=client -o yaml | kubectl apply -f -

  show_step "Applying Gateway API resources"
  kubectl apply -f "${SP}/lib/gateway/gateway.yaml" >/dev/null
  wait_for_resource gateway envoy-gateway-system eg
}

install_registry() {
